  "components": {
    "schemas": {
      "CreateVerificationRequestBody": {
        "properties": {
          "name": {
            "maxLength": 255,
            "minLength": 2,
            "title": "Name",
            "type": "string"
          },
          "purpose": {
            "minLength": 3,
            "title": "Purpose",
            "type": "string"
          },
          "credential_type": {
            "pattern": "^(PID|EAA)$",
            "title": "Credential Type",
            "type": "string"
          },
          "policy_profile": {
            "pattern": "^(high|substantial|low)$",
            "title": "Policy Profile",
            "type": "string"
          },
          "expires_at": {
            "anyOf": [
              {
                "maxLength": 40,
                "minLength": 10,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Expires At"
          },
          "callback_mode": {
            "default": "async",
            "pattern": "^(async|sync)$",
            "title": "Callback Mode",
            "type": "string"
          },
          "redirect_uri": {
            "maxLength": 2048,
            "minLength": 8,
            "title": "Redirect Uri",
            "type": "string"
          },
          "registration_certificate_id": {
            "anyOf": [
              {
                "maxLength": 120,
                "minLength": 3,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Registration Certificate Id"
          },
          "requested_claims": {
            "items": {
              "items": {},
              "type": "array"
            },
            "minItems": 1,
            "title": "Requested Claims",
            "type": "array"
          },
          "rp_service_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Rp Service Id"
          },
          "rp_instance_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Rp Instance Id"
          }
        },
        "required": [
          "name",
          "purpose",
          "credential_type",
          "policy_profile",
          "redirect_uri",
          "requested_claims"
        ],
        "title": "CreateVerificationRequestBody",
        "type": "object"
      },
      "VerificationRequestResponse": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "purpose": {
            "title": "Purpose",
            "type": "string"
          },
          "credential_type": {
            "title": "Credential Type",
            "type": "string"
          },
          "policy_profile": {
            "title": "Policy Profile",
            "type": "string"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "callback_mode": {
            "title": "Callback Mode",
            "type": "string"
          },
          "active": {
            "title": "Active",
            "type": "boolean"
          },
          "published_assets": {
            "additionalProperties": true,
            "title": "Published Assets",
            "type": "object"
          },
          "intended_use_identifier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Intended Use Identifier"
          },
          "requested_claims": {
            "anyOf": [
              {
                "items": {
