            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OutcomeBody"
              },
              "example": {
                "token": "REPLACE_WITH_THE_43_CHARACTER_SIMULATOR_TOKEN",
                "scenario": "approved"
              }
            }
          }
        },
        "x-trustables-retry-safe": false
      }
    }
