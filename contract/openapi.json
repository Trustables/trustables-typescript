        "title": "VerificationRequestResponse",
        "type": "object"
      },
      "VerificationSessionResponse": {
        "properties": {
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "authorization_request_url": {
            "title": "Authorization Request Url",
            "type": "string"
          },
          "request_uri": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Request Uri"
          },
          "state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
