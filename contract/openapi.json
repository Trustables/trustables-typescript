              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Rp Service Id"
          },
          "rp_instance_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Rp Instance Id"
          }
        },
        "required": [
          "id",
          "name",
          "purpose",
          "credential_type",
          "policy_profile",
          "expires_at",
          "callback_mode",
          "active",
          "published_assets"
