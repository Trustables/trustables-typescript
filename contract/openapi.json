    "/api/v1/rp/orgs/{org_id}/simulator/campaigns": {
      "post": {
        "operationId": "createSimulatorCampaign",
        "summary": "Create a Simulator campaign",
        "tags": [
          "Simulator campaigns"
        ],
        "description": "Use a Simulator API key, or a console session with X-Trustables-Environment: simulator. Maximum 25 active campaigns per organisation. This is not a wallet verification request.",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Trustables-Environment",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "simulator"
            },
            "description": "Console sessions must select Simulator. The Simulator API key already fixes the mode."
          }
        ],
        "responses": {
          "201": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Campaign"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Access denied or credential mode mismatch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Environment or session state conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid path parameters or request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Campaign or session creation limit reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CampaignBody"
              },
              "example": {
                "name": "Checkout test",
                "purpose": "Test customer onboarding",
                "profile": "pid"
              }
            }
          }
        },
        "x-trustables-retry-safe": false
      }
    },
    "/api/v1/rp/simulator/inspect": {
      "post": {
        "operationId": "inspectSimulator",
        "summary": "Inspect a Simulator browser session",
        "tags": [
          "Simulator browser"
        ],
        "description": "The token in the body authorises only this expiring session. Send no organisation API key. Complete any required hosted review first; its token is not a Simulator token.",
        "security": [],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulatorInspect"
                }
              }
            }
          },
          "403": {
            "description": "Access denied or hosted review required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Expired or invalid Simulator capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request body",
