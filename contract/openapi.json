            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenBody"
              },
              "example": {
                "token": "REPLACE_WITH_THE_43_CHARACTER_SIMULATOR_TOKEN"
              }
            }
          }
        },
        "x-trustables-retry-safe": true
      }
    },
    "/api/v1/rp/simulator/complete": {
      "post": {
        "operationId": "completeSimulator",
        "summary": "Select a synthetic outcome",
        "tags": [
          "Simulator browser"
        ],
        "description": "One completion per session. Complete any required hosted review first. Ineligible intentionally returns completed and accepted=true; your application must reject the synthetic underage customer.",
        "security": [],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
